INSTRUMENT_PROVIDER=yamnet
HF_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHUNK_DURATION=5
CONFIDENCE_THRESHOLD=0.20
# Optional: re-filter empty YAMNet intervals at 0.15 without another API call.
INSTRUMENT_FALLBACK_ENABLED=false
API_TIMEOUT_SECONDS=45
API_RETRIES=2
MAX_UPLOAD_MB=100
MAX_DURATION_SECONDS=900
# Optional absolute path; otherwise system FFmpeg or imageio-ffmpeg is used.
FFMPEG_PATH=
